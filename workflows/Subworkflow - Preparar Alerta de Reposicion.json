      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\n\nconst texto = (v) => String(v ?? '').trim();\nconst esNumeroValido = (v) => texto(v) !== '' && Number.isFinite(Number(v)) && Number(v) >= 0;\n\nconst motivos = [];\nif (!texto(d.producto)) motivos.push('falta el producto');\nif (!texto(d.categoria)) motivos.push('falta la categoria');\nif (!esNumeroValido(d.cantidad)) motivos.push('cantidad vacia, no numerica o negativa');\nif (!esNumeroValido(d.stock_minimo)) motivos.push('stock minimo vacio, no numerico o negativo');\n\nreturn { json: { ...d, valido: motivos.length === 0, motivo: motivos.join('; ') } };"
      },
