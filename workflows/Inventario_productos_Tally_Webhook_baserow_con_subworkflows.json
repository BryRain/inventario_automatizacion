    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst body = $input.item.json.body;\nif (!body || body.eventType !== 'FORM_RESPONSE' || !body.data) {\n  throw new Error('Payload no reconocido: se esperaba un evento FORM_RESPONSE de Tally');\n}\n\nconst sinAcentos = (s) => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u03f0]/g, '');\nconst clave = (s) => sinAcentos(s).trim().toLowerCase();\n\nconst campos = body.data.fields || [];\n\nconst campo = (palabraClave) => \n  campos.find((f) => clave(f.label).includes(clave(palabraClave)));\n\nconst texto = (f) => {\n  if (!f || f.value === null || f.value === undefined) return '';\n  if (Array.isArray(f.value)) {\n    return f.value\n      .map((id) => (f.options || []).find((o) => o.id === id)?.text ?? id)\n      .join(', ')\n      .trim();\n  }\n  return String(f.value).trim();\n};\n\nconst numero = (f) => {\n  if (!f || f.value === null || f.value === undefined || f.value === '') return NaN;\n  return Number(f.value);\n};\n\nconst campoProducto = campo('Nombre del producto') || campo('Producto');\nconst campoCategoria = campo('Categoria');\nconst campoCantidad = campo('Cantidad Inicial') || campo('Cantidad');\nconst campoStockMin = campo('Stock Minimo') || campo('Stock minimo');\n\nconst producto = texto(campoProducto);\n\nlet categoriaRaw = sinAcentos(texto(campoCategoria)).trim();\nlet categoria = categoriaRaw.charAt(0).toUpperCase() + categoriaRaw.slice(1).toLowerCase();\n\nif (categoria.toLowerCase().startsWith('componen')) {\n  categoria = 'Componentes';\n}\n\nconst cantidad = numero(campoCantidad);\nconst stock_minimo = numero(campoStockMin);\n\nconst errores = [];\nif (!producto) errores.push('falta el producto');\nif (!categoria) errores.push('falta la categoria');\nif (isNaN(cantidad) || !Number.isInteger(cantidad) || cantidad < 0) errores.push('cantidad invalida');\nif (isNaN(stock_minimo) || !Number.isInteger(stock_minimo) || stock_minimo < 0) errores.push('stock minimo invalido');\n\nif (errores.length) {\n  throw new Error('Respuesta ' + body.data.responseId + ' rechazada: ' + errores.join('; '));\n}\n\nreturn { json: { producto, categoria, cantidad, stock_minimo } };"
      },
