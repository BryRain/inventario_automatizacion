    {
      "parameters": {
        "jsCode": "\nconst nuevas = $('Subworkflow Preparar Alerta').all()\n  .map((i) => i.json)\n  .filter((a) => a.estado === 'preparada');\n\n\nconst existentes = $input.all().flatMap((i) => i.json.results ?? []);\n\nconst clave = (nombre, nota) =>\n  String(nombre ?? '').trim().toLowerCase() + '|' + String(nota ?? '').trim();\n\nconst vistas = new Set(existentes.map((e) => clave(e.Nombre, e.Nota)));\n\nconst salida = [];\nfor (const alerta of nuevas) {\n  const k = clave(alerta.producto_normalizado, alerta.cuerpo);\n  if (vistas.has(k)) continue;\n  vistas.add(k);\n  salida.push({ json: alerta });\n}\nreturn salida;"
      },
